# Copy to .env and fill in values for unattended boot.
# Without these, you'll need to run interactive setup commands once
# (see /srv/stack/README — or the closing banner from setup.sh).
#
# Tailscale is NOT configured here. The tailnet identity is host
# tailscaled (setup.sh installs it; `ff-bootstrap` authenticates it) —
# the stack has no tailscale container.

# ----- Preview sites (tailnet-private, real LE certs) -----
#
# Apex you own and want to use for previews. Caddy serves a static
# "online" page at this apex and serves every `<name>.<apex>` subdomain
# you create via `add-preview-site <name> <port-or-dir>`.
#
# DNS: in your DNS provider, point this apex and a wildcard at this
# box's tailnet IP, DNS-only (not proxied):
#   $PREVIEW_APEX        A    <tailnet IP>
#   *.$PREVIEW_APEX      A    <tailnet IP>
#
# Off-tailnet clients can't reach the IP (it's CGNAT), so previews stay
# private. Caddy serves a real LE wildcard cert via ACME DNS-01 against
# Cloudflare.
PREVIEW_APEX=previews.example.com

# Cloudflare API token used by caddy for ACME DNS-01.
#
# Generate at:  https://dash.cloudflare.com/profile/api-tokens
# Permissions:  Zone — DNS — Edit, scoped to the zone hosting $PREVIEW_APEX
# (Zone — Zone — Read is also required by the LE module.)
#
# This token is also the on/off switch for the :443 preview listener:
# while it's empty, docker-compose leaves the wildcard site out of the
# caddy config entirely, so an unconfigured install never spins on
# failing DNS-01 retries. Set it (plus a real PREVIEW_APEX above), then
# `docker compose up -d` to enable previews.
CF_API_TOKEN=

# ----- Cloudflare Tunnel (token-managed public ingress) -----
#
# Opt-in. The tunnel + its public hostnames are configured in the
# Cloudflare Zero Trust dashboard (Networks → Tunnels → "+ Create a
# tunnel" → Cloudflared → copy the connector token; route each public
# hostname to http://localhost:8080 in the tunnel's Public Hostnames
# tab), and the connector authenticates with the token below. No
# cert.pem / credentials.json / config.yml needed.
#
# The connector service is gated behind a compose profile so token-less
# installs don't crash-loop it. Setting the token does nothing on its
# own — ALSO uncomment the profile line:
# COMPOSE_PROFILES=cloudflared
CLOUDFLARED_TOKEN=
