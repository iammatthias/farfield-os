# farfield os — Caddy configuration. Three listeners:
#
#   :80   — PRIVATE HTTP. Reached over the tailnet (caddy lives in the
#           tailscale container's netns). Internal services via add-site.
#
#   :443  — PRIVATE HTTPS. Reached over the tailnet on
#           {$PREVIEW_APEX} and *.{$PREVIEW_APEX}. Real LE wildcard cert
#           issued via ACME DNS-01 against Cloudflare. Tailnet-private
#           because DNS for *.$PREVIEW_APEX points at this box's
#           tailnet IP (CGNAT — not routable outside the tailnet).
#           Gated: only loads once CF_API_TOKEN is set in .env — see
#           the import below.
#
#   :8080 — PUBLIC HTTP. Reached by the cloudflared connector (opt-in
#           per-site via `add-public-site`). TLS terminates at the CF
#           edge; this listener is plain HTTP.
#
# `{$PREVIEW_APEX}` and `{env.CF_API_TOKEN}` are substituted at
# config-load / cert-issuance time from env vars set by docker-compose
# from /srv/stack/.env.
#
# Edits land via:
#   docker compose -f /srv/stack/docker-compose.yml exec caddy caddy reload --config /etc/caddy/Caddyfile
# (--config is required: the image's workdir has no Caddyfile.)
# `add-site` (private :80), `add-public-site` (cloudflared :8080), and
# `add-preview-site` (private HTTPS subdomain) all do this for you.

# Global options.
{
    servers {
        # Public traffic arrives from cloudflared over LOOPBACK inside
        # the shared tailscale netns. Without trusting loopback as a
        # proxy, every public request logs client_ip 127.0.0.1 and
        # backends receive X-Forwarded-Proto: http — https redirect
        # loops and broken Secure cookies. private_ranges covers
        # 127.0.0.0/8 (plus RFC1918 and the tailnet's CGNAT
        # 100.64.0.0/10).
        #
        # Caveat: :8080 is ALSO reachable directly from the tailnet, so
        # on that listener CF-Connecting-IP / X-Forwarded-For can be
        # spoofed by any tailnet peer. Apps must never use those headers
        # for auth or rate-limiting.
        trusted_proxies static private_ranges
    }
}

# Shared JSON access log — every site imports this; ff-board tails the
# file (host: /srv/stack/data/caddy/data/access/access.log) for per-site
# request rates and status-code mixes on the kiosk. mode 644 so the
# unprivileged board can read it.
(ff_access_log) {
    log {
        output file /data/access/access.log {
            roll_size 20mb
            roll_keep 2
            mode 644
        }
        format json
    }
}

# =============================================================================
# PRIVATE — tailnet only (HTTP, :80)
# =============================================================================

# Default site on :80 — any hostname pointing at the box that doesn't
# match a more-specific block below gets the static "online" homepage.
:80 {
    import ff_access_log
    root * /srv/homepage
    file_server
}

# add-site appends private vhosts below this line.
# -------- PRIVATE-SITES --------

# =============================================================================
# PRIVATE — tailnet only (HTTPS wildcard, :443)
# =============================================================================
#
# The wildcard-preview site lives in preview-https/wildcard.caddy and is
# GATED on CF_API_TOKEN being set: docker-compose sets
# PREVIEW_HTTPS=https only when the token is non-empty, completing this
# import path. Otherwise the glob resolves under a directory that
# doesn't exist and matches nothing (a zero-match glob is not an error),
# so the :443 site — and its ACME DNS-01 issuance, which would retry
# forever with an empty token against the placeholder apex — never
# loads. No extra .env knob: the token IS the switch.

import /etc/caddy/preview-{$PREVIEW_HTTPS:off}/*.caddy

# =============================================================================
# PUBLIC — cloudflared tunnel target (opt-in via add-public-site)
# =============================================================================

http://:8080 {
    import ff_access_log
    respond 404
}

# add-public-site appends public vhosts below this line.
# -------- PUBLIC-SITES --------
#
# Real per-site blocks are appended here by `add-public-site` at runtime
# and live only on the server (/srv/stack/Caddyfile). They are deliberately
# NOT tracked in this public repo — keep deployment-specific hostnames and
# topology out of the boilerplate.
