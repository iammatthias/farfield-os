# ----- Caddy site management (Caddy runs in /srv/stack) -----
#
# Two listeners:
#   :80   — private vhosts (tailnet only). Use add-site.
#   :8080 — public vhosts (Cloudflare Tunnel target). Use add-public-site.

FF_CADDYFILE=/srv/stack/Caddyfile
# Use -f to point compose at the file directly so `sudo $FF_CADDY_RELOAD`
# is a single command — `sudo cd ...` fails because cd is a shell builtin.
FF_CADDY_RELOAD='docker compose -f /srv/stack/docker-compose.yml exec -T caddy caddy reload --config /etc/caddy/Caddyfile'

# Shared awk program for Caddyfile edits. Drops generated site blocks
# whose address line equals a1 or a2, and (when $FF_BLOCK is non-empty)
# inserts it right after the line equal to marker, appending at EOF if
# no marker line exists. The block travels via ENVIRON, not -v: -v
# mangles backslashes and BSD awk rejects newlines in -v values.
#
# The delete matches the EXACT generated block shape:
#     <blank line>
#     # private: <name>            (or "# public:", "# ... static:")
#     <address line> {
#         <indented directives>
#     }
# i.e. from the literal address line through the first "}" alone at
# column 0, plus the generated comment/blank line above it. That is
# precise for anything these helpers wrote; a hand-added block is only
# at risk if it reuses a generated address line AND indents its closing
# brace — don't do that.
_FF_CADDY_AWK='
BEGIN { n = 0; skip = 0; ins = 0; block = ENVIRON["FF_BLOCK"] }
skip { if ($0 == "}") skip = 0; next }
(a1 != "" && $0 == a1) || (a2 != "" && $0 == a2) {
    if (n > 0 && lines[n] ~ /^# (private|public)( static)?: /) n--
    if (n > 0 && lines[n] == "") n--
    skip = 1
    next
}
{
    lines[++n] = $0
    if (block != "" && ins == 0 && $0 == marker) { lines[++n] = block; ins = 1 }
}
END {
    for (i = 1; i <= n; i++) print lines[i]
    if (block != "" && ins == 0) print block
}'

# Rewrite $FF_CADDYFILE through $_FF_CADDY_AWK. Builds the result in
# a temp file and sudo-cp's it over the live file, so a failed edit never
# leaves it half-written. Usage:
#   _ff_caddy_rewrite <marker-line> <block> <addr1> [addr2]
_ff_caddy_rewrite() {
    local tmp
    tmp=$(mktemp) || return 1
    if ! sudo env "FF_BLOCK=$2" awk -v marker="$1" -v a1="$3" -v a2="${4:-}" \
            "$_FF_CADDY_AWK" "$FF_CADDYFILE" > "$tmp" \
        || [ ! -s "$tmp" ]; then
        rm -f "$tmp"
        return 1
    fi
    sudo cp "$tmp" "$FF_CADDYFILE" || { rm -f "$tmp"; return 1; }
    rm -f "$tmp"
}

# Reload caddy after a Caddyfile edit. $1 = backup to restore if caddy
# rejects the config. Three outcomes:
#   reload OK         → drop the backup, return 0
#   caddy not running → KEEP the edit (it may well be valid), drop the
#                       backup, tell the user to start the stack
#   config rejected   → show caddy's error, restore the backup
_ff_caddy_reload() {
    local backup=$1
    local out
    if out=$(eval "sudo $FF_CADDY_RELOAD" 2>&1); then
        sudo rm -f "$backup"
        return 0
    fi
    if [ -z "$(sudo docker compose -f /srv/stack/docker-compose.yml ps -q --status running caddy 2>/dev/null)" ]; then
        echo "Caddy container isn't running — edit saved but not applied."
        echo "Start the stack (cd /srv/stack && docker compose up -d), then run: caddy-reload"
        sudo rm -f "$backup"
        return 0
    fi
    echo "Caddy rejected the config — rolling back. Reload output:"
    printf '%s\n' "$out"
    sudo mv "$backup" "$FF_CADDYFILE"
    return 1
}

# Insert a site block after a marker line and reload caddy. The backup
# is taken BEFORE any mutation (including the replace-existing delete)
# and restored if caddy rejects the result.
#   _ff_caddy_append <MARKER-NAME> <block> [existing-address-line]
# MARKER-NAME is PRIVATE-SITES or PUBLIC-SITES (the
# "# -------- MARKER-NAME --------" lines in the Caddyfile); if the
# marker line is missing the block is appended at EOF instead.
# existing-address-line, when given, replaces any previously generated
# block starting with that exact line (see _FF_CADDY_AWK).
_ff_caddy_append() {
    local marker="# -------- $1 --------"
    local block=$2
    local existing=${3:-}
    local backup="$FF_CADDYFILE.backup.$(date +%Y%m%d_%H%M%S)"

    sudo cp "$FF_CADDYFILE" "$backup" || return 1

    if ! _ff_caddy_rewrite "$marker" "$block" "$existing"; then
        echo "Failed to edit Caddyfile — live copy untouched"
        sudo rm -f "$backup"
        return 1
    fi

    _ff_caddy_reload "$backup"
}

# --- Private vhost on :80 (tailnet) -----------------------------------------
add-site() {
    if [ -z "$1" ]; then
        echo "Usage: add-site <name> [port|directory]"
        echo "Examples:"
        echo "  add-site myapp 3000              # reverse proxy http://myapp.local → host:3000"
        echo "  add-site static /srv/projects/x  # serve static dir"
        echo "Tailnet only. For public sites, use add-public-site."
        return 1
    fi

    local name=$1
    local target=${2:-3000}

    # Names are spliced into the Caddyfile — keep them boring.
    if ! [[ "$name" =~ ^[a-z0-9-]+$ ]]; then
        echo "Invalid site name '$name' — lowercase letters, digits, and hyphens only"
        return 1
    fi

    local block
    if [[ "$target" =~ ^[0-9]+$ ]]; then
        block=$(printf '\n# private: %s\n%s.local:80 {\n    import ff_access_log\n    reverse_proxy host.docker.internal:%s\n}' \
            "$name" "$name" "$target")
        _ff_caddy_append PRIVATE-SITES "$block" "$name.local:80 {" \
            && echo "Private site: http://$name.local → host:$target"
    else
        if [ ! -d "$target" ]; then
            echo "Directory $target does not exist"
            return 1
        fi
        block=$(printf '\n# private static: %s\n%s.local:80 {\n    import ff_access_log\n    root * %s\n    file_server\n}' \
            "$name" "$name" "$target")
        _ff_caddy_append PRIVATE-SITES "$block" "$name.local:80 {" \
            && echo "Private static: http://$name.local → $target"
        echo "Note: $target must be bind-mounted into the caddy container (edit /srv/stack/docker-compose.yml)."
    fi
}

# --- Public vhost on :8080 (Cloudflare Tunnel) ------------------------------
add-public-site() {
    if [ -z "$1" ]; then
        echo "Usage: add-public-site <hostname> [port|directory]"
        echo "Examples:"
        echo "  add-public-site myapp.example.com 3000"
        echo "  add-public-site blog.example.com /srv/projects/blog/public"
        echo "Public via cloudflared. You also need to (a) configure the public"
        echo "hostname → http://localhost:8080 route in the Cloudflare dashboard,"
        echo "and (b) point DNS at the tunnel."
        return 1
    fi

    local host=$1
    local target=${2:-3000}

    # Hostnames are spliced into the Caddyfile — keep them boring.
    if ! [[ "$host" =~ ^[A-Za-z0-9.-]+$ ]]; then
        echo "Invalid hostname '$host' — letters, digits, dots, and hyphens only"
        return 1
    fi

    local block
    if [[ "$target" =~ ^[0-9]+$ ]]; then
        block=$(printf '\n# public: %s\nhttp://%s:8080 {\n    import ff_access_log\n    reverse_proxy host.docker.internal:%s\n}' \
            "$host" "$host" "$target")
        _ff_caddy_append PUBLIC-SITES "$block" "http://$host:8080 {" \
            && echo "Public site: https://$host → host:$target (via tunnel)"
    else
        if [ ! -d "$target" ]; then
            echo "Directory $target does not exist"
            return 1
        fi
        block=$(printf '\n# public static: %s\nhttp://%s:8080 {\n    import ff_access_log\n    root * %s\n    file_server\n}' \
            "$host" "$host" "$target")
        _ff_caddy_append PUBLIC-SITES "$block" "http://$host:8080 {" \
            && echo "Public static: https://$host → $target (via tunnel)"
        echo "Note: $target must be bind-mounted into the caddy container (edit /srv/stack/docker-compose.yml)."
    fi
}

# --- Preview vhost on the *.$PREVIEW_APEX wildcard (tailnet-private) -------
# Convention: every preview gets <name>.$PREVIEW_APEX, served by caddy with
# a real LE wildcard cert (DNS-01 via Cloudflare). Tailnet-private because
# *.$PREVIEW_APEX DNS resolves to this box's tailnet IP.
#
# Each preview is one fragment file under /srv/stack/preview-handles/<name>.caddy
# imported into the wildcard HTTPS block in /srv/stack/Caddyfile.
FF_PREVIEW_HANDLES=/srv/stack/preview-handles

_ff_preview_apex() {
    local apex
    apex=$(awk -F= '/^PREVIEW_APEX=/{print $2}' /srv/stack/.env 2>/dev/null \
        | tr -d "\"' ")
    printf '%s' "${apex:-previews.example.com}"
}

add-preview-site() {
    if [ -z "$1" ]; then
        local apex; apex=$(_ff_preview_apex)
        echo "Usage: add-preview-site <name> [port|directory]"
        echo "Examples:"
        echo "  add-preview-site hello /srv/projects/hello-world"
        echo "  add-preview-site myapp 3000"
        echo "Visible at: https://<name>.$apex (tailnet-private)"
        echo "PREVIEW_APEX is read from /srv/stack/.env."
        return 1
    fi

    local name=$1
    local target=${2:-3000}

    # The name becomes a handle file path AND a caddy matcher name — a
    # `/` would let sudo tee write outside preview-handles/, and "apex"
    # would collide with the @apex matcher in the wildcard block.
    if ! [[ "$name" =~ ^[a-z0-9-]+$ ]]; then
        echo "Invalid preview name '$name' — lowercase letters, digits, and hyphens only"
        return 1
    fi
    if [[ "$name" == "apex" ]]; then
        echo "'apex' is reserved (the wildcard block's @apex matcher) — pick another name"
        return 1
    fi

    local apex
    apex=$(_ff_preview_apex)
    local host="$name.$apex"
    local handle_file="$FF_PREVIEW_HANDLES/$name.caddy"
    local backup_file=""

    sudo mkdir -p "$FF_PREVIEW_HANDLES"
    if sudo test -f "$handle_file"; then
        backup_file="$handle_file.backup.$(date +%Y%m%d_%H%M%S)"
        sudo cp "$handle_file" "$backup_file"
    fi

    if [[ "$target" =~ ^[0-9]+$ ]]; then
        sudo tee "$handle_file" > /dev/null <<EOF
# preview: $name → host:$target
@$name host $host
handle @$name {
    reverse_proxy host.docker.internal:$target
}
EOF
    else
        if [ ! -d "$target" ]; then
            echo "Directory $target does not exist"
            return 1
        fi
        sudo tee "$handle_file" > /dev/null <<EOF
# preview static: $name → $target
@$name host $host
handle @$name {
    root * $target
    file_server
}
EOF
    fi

    if eval "sudo $FF_CADDY_RELOAD"; then
        echo "Preview: https://$host → $target"
        [ -n "$backup_file" ] && sudo rm -f "$backup_file"
        return 0
    else
        echo "Caddy reload failed — rolling back"
        if [ -n "$backup_file" ]; then
            sudo mv "$backup_file" "$handle_file"
        else
            sudo rm -f "$handle_file"
        fi
        return 1
    fi
}

remove-preview-site() {
    if [ -z "$1" ]; then
        echo "Usage: remove-preview-site <name>"
        return 1
    fi
    local handle_file="$FF_PREVIEW_HANDLES/$1.caddy"
    if ! sudo test -f "$handle_file"; then
        echo "No preview at $handle_file"
        return 1
    fi
    sudo rm -f "$handle_file"
    eval "sudo $FF_CADDY_RELOAD" && echo "Removed preview: $1"
}

list-preview-sites() {
    local apex; apex=$(_ff_preview_apex)
    if ! sudo test -d "$FF_PREVIEW_HANDLES"; then
        echo "No previews."
        return
    fi
    for f in $(sudo find "$FF_PREVIEW_HANDLES" -maxdepth 1 -name '*.caddy' 2>/dev/null); do
        local name; name=$(basename "$f" .caddy)
        printf "  https://%s.%s\n" "$name" "$apex"
    done
}

list-sites() {
    if [ ! -f "$FF_CADDYFILE" ]; then
        echo "No Caddyfile at $FF_CADDYFILE"
        return
    fi
    # Capture first — `grep | sed || echo` never fires the echo, because
    # sed exits 0 even when grep matched nothing.
    local out
    echo "Private (tailnet):"
    out=$(sudo grep -E "^[a-zA-Z0-9.-]+\.local:80 \{" "$FF_CADDYFILE" 2>/dev/null \
        | sed 's/ {//;s/^/  /')
    if [ -n "$out" ]; then printf '%s\n' "$out"; else echo "  (none)"; fi
    echo "Public (cloudflared):"
    out=$(sudo grep -E "^http://[a-zA-Z0-9.-]+:8080 \{" "$FF_CADDYFILE" 2>/dev/null \
        | sed 's| {||;s|^http://|  |')
    if [ -n "$out" ]; then printf '%s\n' "$out"; else echo "  (none)"; fi
}

remove-site() {
    if [ -z "$1" ]; then
        echo "Usage: remove-site <name-or-hostname>"
        echo "Matches both private (.local:80) and public (:8080) blocks."
        return 1
    fi

    local name=$1
    if ! [[ "$name" =~ ^[A-Za-z0-9.-]+$ ]]; then
        echo "Invalid name '$name' — letters, digits, dots, and hyphens only"
        return 1
    fi

    local backup="$FF_CADDYFILE.backup.$(date +%Y%m%d_%H%M%S)"
    sudo cp "$FF_CADDYFILE" "$backup" || return 1

    # Deletes only exact generated blocks — see _FF_CADDY_AWK.
    if ! _ff_caddy_rewrite "" "" "$name.local:80 {" "http://$name:8080 {"; then
        echo "Failed to edit Caddyfile — live copy untouched"
        sudo rm -f "$backup"
        return 1
    fi
    # Note: preview subdomains live in /srv/stack/preview-handles/<name>.caddy,
    # not in the Caddyfile. Use `remove-preview-site` for those.

    _ff_caddy_reload "$backup" && echo "Removed $name from Caddy"
}

test-caddy() {
    sudo docker compose -f /srv/stack/docker-compose.yml exec -T caddy caddy validate --config /etc/caddy/Caddyfile
}

caddy-status() {
    sudo docker compose -f /srv/stack/docker-compose.yml ps caddy
    echo
    sudo docker compose -f /srv/stack/docker-compose.yml logs --tail 20 caddy
}

# ----- PM2 management -----

pm2-start() {
    if [ -z "$1" ]; then
        echo "Usage: pm2-start <ecosystem-file>"
        return 1
    fi
    if [ ! -f "$1" ]; then
        echo "Ecosystem file $1 not found"
        return 1
    fi
    pm2 start "$1"
    pm2 list
}

pm2-add-site() {
    if [ -z "$1" ] || [ -z "$2" ] || [ -z "$3" ]; then
        echo "Usage: pm2-add-site <name> <port> <ecosystem-file>"
        return 1
    fi
    pm2-start "$3"
    add-site "$1" "$2"
}

pm2-remove() {
    if [ -z "$1" ]; then
        echo "Usage: pm2-remove <name>"
        return 1
    fi
    pm2 stop "$1" 2>/dev/null || true
    pm2 delete "$1" 2>/dev/null || true
}

pm2-restart() {
    if [ -z "$1" ]; then
        echo "Usage: pm2-restart <name>"
        return 1
    fi
    pm2 restart "$1"
    pm2 list
}

pm2-logs() {
    if [ -z "$1" ]; then
        echo "Usage: pm2-logs <name>"
        return 1
    fi
    pm2 logs "$1"
}

pm2-status() {
    pm2 list
    echo
    list-sites
}

# ----- System status helpers -----

system-status() {
    echo "Uptime: $(uptime -p)"
    echo "Load:   $(uptime | awk -F'load average:' '{print $2}')"
    echo "Memory: $(free -h | awk '/^Mem:/ {print $3 "/" $2}')"
    echo "Disk:   $(df -h / | awk 'NR==2 {print $3 "/" $2 " (" $5 " used)"}')"
    echo
    echo "=== Top processes ==="
    ps aux --sort=-%cpu | head -10
    echo
    echo "=== Listening ==="
    ss -tulpn | grep LISTEN | head -10
}

db-status() {
    echo "=== PostgreSQL ==="
    sudo systemctl status postgresql --no-pager
    echo
    echo "=== Valkey ==="
    sudo systemctl status valkey --no-pager
    echo
    psql -c "SELECT count(*) AS connections FROM pg_stat_activity;" 2>/dev/null || echo "PostgreSQL not accessible"
    valkey-cli info clients 2>/dev/null | grep connected_clients || echo "Valkey not accessible"
}

security-status() {
    echo "=== UFW ==="
    sudo ufw status verbose
    echo
    echo "=== Fail2ban ==="
    sudo fail2ban-client status
    echo
    echo "=== SSH ==="
    sudo systemctl status sshd --no-pager
    echo
    sudo journalctl -u sshd --no-pager -n 10
}

port-check() {
    if [ -z "$1" ]; then
        echo "Usage: port-check <port>"
        return 1
    fi
    if lsof -i ":$1" >/dev/null 2>&1; then
        echo "Port $1 in use:"
        lsof -i ":$1"
    else
        echo "Port $1 is available"
    fi
}

# ----- Backup -----

backup-system() {
    local dir="$HOME/backups/$(date +%Y%m%d_%H%M%S)"
    mkdir -p "$dir"
    # Snapshot config dirs, but EXCLUDE /etc/ssh/ssh_host_*_key* — host
    # private keys must not land in a user-owned backup directory.
    sudo rsync -a \
        --exclude='ssh_host_*_key' \
        --exclude='ssh_host_*_key.pub' \
        /srv/stack/Caddyfile /etc/ssh /etc/ufw /etc/fail2ban "$dir/" 2>/dev/null || true
    cp -r ~/.zshrc ~/.tmux.conf ~/.config "$dir/" 2>/dev/null || true
    sudo chown -R "$USER:$USER" "$dir"
    echo "Backup: $dir"
}

# ----- Project scaffolding -----

create-react-hono() {
    if [ -z "$1" ]; then
        echo "Usage: create-react-hono <project-name>"
        return 1
    fi

    local name=$1
    local dir="$HOME/projects/$name"

    mkdir -p "$dir"
    cd "$dir" || return 1

    npm init -y
    npm install hono @hono/node-server react react-dom
    npm install -D @types/node @types/react @types/react-dom typescript tsx vite @vitejs/plugin-react concurrently

    mkdir -p src/{client,server}

    cat > src/server/index.ts << 'HONO'
import { Hono } from 'hono'
import { serve } from '@hono/node-server'

const app = new Hono()

app.get('/', (c) => c.json({ message: 'Hello Hono!' }))
app.get('/api/health', (c) => c.json({ status: 'ok', timestamp: new Date().toISOString() }))

serve({ fetch: app.fetch, port: 3000 })
console.log('Server running on port 3000')
HONO

    cat > src/client/App.tsx << 'REACT'
export default function App() {
  return <div><h1>React + Hono</h1></div>
}
REACT

    cat > vite.config.ts << 'VITE'
import { defineConfig } from 'vite'
import react from '@vitejs/plugin-react'

export default defineConfig({
  plugins: [react()],
  server: { proxy: { '/api': 'http://localhost:3000' } }
})
VITE

    echo "Created $dir"
    echo "Next: cd $dir && npm run dev && add-site $name 3000"
}

