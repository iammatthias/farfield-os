# Functions
mkcd() {
    mkdir -p "$1" && cd "$1"
}

up() {
    local levels=${1:-1}
    local path=""
    for ((i=1; i<=levels; i++)); do
        path="../$path"
    done
    cd "$path"
}

# Show what's listening on a port
port() {
    [[ -z "$1" ]] && { echo "Usage: port <port>"; return 1 }
    lsof -i tcp:"$1" || echo "No process found on port $1"
}

# Kill whatever is listening on a port (handles multiple PIDs)
killport() {
    [[ -z "$1" ]] && { echo "Usage: killport <port>"; return 1 }
    local -a pids
    pids=( ${(f)"$(lsof -t -i tcp:"$1")"} )
    if (( $#pids )); then
        kill "${pids[@]}" && echo "Killed: ${pids[*]}"
    else
        echo "No process found on port $1"
    fi
}

