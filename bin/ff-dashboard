#!/bin/bash
# farfield os — the ssh view of ff-board.
#
# Runs the full board (host CPU/MEM/NET/DISK graphs, per-container
# sparklines, stack status, diff-rendered — no flicker) in the current
# terminal. The kiosk display doesn't use this — sway tiles six
# single-panel ff-board instances (see configs/sway-config).
#
# Persistence comes from herdr, not from this script: run `herdr` (or
# `herdr --remote iam@<host>` from another machine) and start
# ff-dashboard inside the session — it survives ssh drops and reattaches
# from any device. The old tmux-session plumbing is gone with tmux.
#
# Fallback (ff-board not built — cargo missing at setup time): btop.
set -uo pipefail

if command -v ff-board >/dev/null 2>&1; then
    exec ff-board
fi
exec btop
