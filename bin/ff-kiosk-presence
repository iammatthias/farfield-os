#!/bin/bash
# farfield os — presence-based display power for the kiosk (burn-in guard).
#
# Polls a computer-vision endpoint (state.json with live detection `boxes`
# and enter/exit `events`) and sleeps the display when nobody has been seen
# for a while; wakes it the moment someone is. Launched by sway's exec in a
# respawn loop.
#
# FAIL-OPEN by design — every failure mode leaves the display ON:
#   - API unreachable / bad JSON / HTTP error        -> on
#   - pipeline stale (`.age` too old, HTTP still up) -> on
#   - daemon exits or is killed (trap)               -> on
#   - boot grace: never sleeps in the first ABSENT_SECS after start
# Manual control (ff-display on|auto) and the tap override (a tap on the
# dark panel wakes it for OVERRIDE_SECS — written by ff-board) always win.
#
# Presence = a person box in the current frame (confidence >= CONF), OR a
# new person enter/exit event since the previous poll. Event timestamps are
# compared only against themselves (change detection), never against our
# clock — so skew between this box and the CV box can't cause flapping.

set -uo pipefail

CV_URL=${CV_URL:-http://cv.local:8001/state.json}
POLL=${POLL:-2}                    # seconds between polls (fallback wake path)
ABSENT_SECS=${ABSENT_SECS:-180}    # continuous absence before sleeping
OVERRIDE_SECS=${OVERRIDE_SECS:-600} # tap keeps the display on this long
CONF=${CONF:-0.5}                  # min detection confidence
MAX_AGE=${MAX_AGE:-30}             # .age beyond this = stale pipeline

DIR=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/ff-display
mkdir -p "$DIR"

once=${1:-}

# Singleton — a stale twin from a previous sway session exits on its own
# (dead SWAYSOCK check below), but don't ever run two control loops.
# --once while the daemon holds the lock: show the daemon's latest
# decision instead of exiting silently (that's exactly when you'd ask).
exec 9>"$DIR/lock"
if ! flock -n 9; then
    if [ "$once" = "--once" ]; then
        cat "$DIR/status" 2>/dev/null || echo "(presence daemon running — no status written yet)"
    fi
    exit 0
fi

power() { swaymsg "output * power $1" >/dev/null 2>&1; }

# The state file is shared — ff-board's tap-wake and ff-display also
# write it — so trust the file, not our own memory of what we last did.
# Every actual transition lands in the systemd journal (tag ff-display)
# so wake/sleep history is auditable: `ff-display log`.
set_state() {
    local cur
    cur=$(cat "$DIR/state" 2>/dev/null || echo unknown)
    if [ "$1" != "$cur" ]; then
        power "$1"
        echo "$1" > "$DIR/state"
        logger -t ff-display "display $1 — ${2:-}"
    fi
}

# Whatever kills us, leave the display on.
trap 'power on; echo on > "$DIR/state"; logger -t ff-display "display on — presence daemon exited (fail open)"' EXIT
logger -t ff-display "presence daemon started (poll=${POLL}s absent=${ABSENT_SECS}s override=${OVERRIDE_SECS}s)"

last_seen=$(date +%s)   # boot grace — assume presence at start
prev_event_ts=""

while :; do
    now=$(date +%s)

    # sway gone (kiosk restart) — exit; the new session respawns us.
    [ -n "${SWAYSOCK:-}" ] && [ ! -S "$SWAYSOCK" ] && exit 0

    mode=$(cat "$DIR/mode" 2>/dev/null || echo auto)
    want=on reason=""

    if [ "$mode" = "on" ]; then
        reason="pinned (ff-display on)"
    elif [ -f "$DIR/override" ] && \
         [ $((now - $(stat -c %Y "$DIR/override" 2>/dev/null || echo 0))) -lt "$OVERRIDE_SECS" ]; then
        reason="tap override"
    else
        body=$(curl -sf -m 2 "$CV_URL" 2>/dev/null)
        parsed=$(jq -r --argjson conf "$CONF" '
            [ ([.boxes[]? | select((.label // "") == "person")
                          | select((.confidence // 1) >= $conf)] | length),
              ([.events[]? | select((.label // "") == "person") | .ts] | max // 0),
              (.age // 0) ] | @tsv' <<<"$body" 2>/dev/null)
        if [ -z "$parsed" ]; then
            reason="api down — fail open"
            api=down
        else
            IFS=$'\t' read -r nperson newest_ts age <<<"$parsed"
            api=ok
            if [ "$(printf '%.0f' "$age")" -gt "$MAX_AGE" ] 2>/dev/null; then
                reason="pipeline stale (age ${age}s) — fail open"
            else
                if [ "${nperson:-0}" -gt 0 ] || { [ -n "$prev_event_ts" ] && [ "$newest_ts" != "$prev_event_ts" ]; }; then
                    last_seen=$now
                fi
                prev_event_ts=$newest_ts
                # Push nudges (ff-kiosk-wake-listener touches $DIR/push on
                # each CV enter/exit datagram) count as presence too.
                push_ts=$(stat -c %Y "$DIR/push" 2>/dev/null || echo 0)
                [ "$push_ts" -gt "$last_seen" ] && last_seen=$push_ts
                ago=$((now - last_seen))
                if [ "$ago" -lt "$ABSENT_SECS" ]; then
                    [ "${nperson:-0}" -gt 0 ] && reason="person in frame" || reason="seen ${ago}s ago"
                else
                    want=off reason="absent ${ago}s"
                fi
            fi
        fi
    fi

    set_state "$want" "$reason"
    echo "state=$want mode=$mode reason='$reason' api=${api:-skip} $(date +%H:%M:%S)" > "$DIR/status"

    [ "$once" = "--once" ] && { cat "$DIR/status"; trap - EXIT; exit 0; }
    sleep "$POLL"
done
