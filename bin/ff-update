#!/bin/bash
# ff-update [--yes|-y] — pacman -Syu + cache clean.
#
# Interactive by default. --yes runs unattended AND under systemd-run,
# so the upgrade survives a dropped ssh session — pacman dying mid-
# transaction is the one failure mode worth engineering around. snap-pac
# wraps the transaction in btrfs snapshots either way.
set -euo pipefail

case "${1:-}" in
    --help | -h)
        echo "usage: ff-update [--yes|-y]"
        echo "  --yes  unattended, under systemd-run so it survives an ssh drop"
        exit 0
        ;;
esac

if [ "${1:-}" = "--yes" ] || [ "${1:-}" = "-y" ]; then
    UNIT=ff-sysupgrade
    echo "Updating system (unattended, via systemd-run)..."
    sudo systemctl reset-failed "$UNIT.service" 2>/dev/null || true
    sudo systemd-run --unit="$UNIT" pacman -Syu --noconfirm

    # Stream progress from the journal; killing the follower (or losing
    # the ssh session) doesn't touch the upgrade itself.
    sudo journalctl -fu "$UNIT.service" --no-hostname -o cat &
    follow=$!
    while systemctl is-active --quiet "$UNIT.service"; do sleep 2; done
    # $follow is the sudo pid (root) — a plain kill from the invoking user
    # is EPERM, and the silent failure left `wait` blocking forever.
    sudo -n kill "$follow" 2>/dev/null || kill "$follow" 2>/dev/null || true
    wait "$follow" 2>/dev/null || true

    rc=$(systemctl show "$UNIT.service" -p ExecMainStatus --value)
    sudo systemctl reset-failed "$UNIT.service" 2>/dev/null || true
    if [ "${rc:-1}" != "0" ]; then
        echo "ff-update: upgrade FAILED (exit $rc) — see: journalctl -u $UNIT" >&2
        exit 1
    fi
else
    echo "Updating system..."
    sudo pacman -Syu
fi

# An openssh upgrade leaves the OLD listener paired with a NEW
# per-session binary it can't exec — every fresh connection then dies at
# the handshake until sshd restarts, and Arch deliberately doesn't
# restart it for you. Restarting does NOT drop existing sessions
# (children are independent processes). This exact lockout happened
# 2026-07-26; never again.
if sudo tail -n 2000 /var/log/pacman.log | grep -q "upgraded openssh "; then
    echo "openssh was upgraded — restarting sshd (existing sessions unaffected)"
    sudo systemctl try-restart sshd
fi

echo "Cleaning package cache..."
sudo pacman -Sc --noconfirm
echo "Done."
