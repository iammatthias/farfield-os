#!/bin/bash
# farfield os — read-only convergence check.
#
# Answers one question: does this box still match what the repo says it
# should be? Nothing here writes, restarts, or installs — it is safe to
# run at any time, and it's the right first move for an agent session
# that's about to change something.
#
# It exists because drift is silent. The 2026-08-14 tailnet migration
# retired a container the board still polled; nothing was down, no error
# was logged, and every site probe simply stopped running while showing
# green. Checks below are written to catch that shape of failure: not
# "is it broken" but "does each half still agree with the other".
#
#   ff-doctor            run every check
#   ff-doctor --quiet    print only problems (for cron / hooks)
#
# Exit: 0 all clear, 1 warnings, 2 errors.
set -uo pipefail

QUIET=0
case "${1:-}" in
    --quiet | -q) QUIET=1 ;;
    --help | -h)
        echo "usage: ff-doctor [--quiet]"
        echo "  read-only check that the box still matches the repo."
        echo "  exit 0 = clear, 1 = warnings, 2 = errors"
        exit 0
        ;;
esac

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; DIM='\033[2m'; NC='\033[0m'
ERRORS=0
WARNS=0

section() { [ "$QUIET" = 1 ] || printf "\n%b── %s%b\n" "$DIM" "$1" "$NC"; }
ok()   { [ "$QUIET" = 1 ] || printf "  %bok%b    %s\n" "$GREEN" "$NC" "$1"; }
warn() { WARNS=$((WARNS + 1));  printf "  %bwarn%b  %s\n" "$YELLOW" "$NC" "$1"; }
err()  { ERRORS=$((ERRORS + 1)); printf "  %bERR%b   %s\n" "$RED" "$NC" "$1"; }
note() { [ "$QUIET" = 1 ] || printf "        %b%s%b\n" "$DIM" "$1" "$NC"; }

REPO=${FF_REPO:-}
if [ -z "$REPO" ]; then
    for cand in "$HOME/farfield-os" "$HOME/gnar"; do
        [ -d "$cand/.git" ] && REPO=$cand && break
    done
fi

# ---------------------------------------------------------------------------
section "repo"
# ---------------------------------------------------------------------------
if [ -z "$REPO" ] || [ ! -d "$REPO/.git" ]; then
    warn "no repo checkout found (set FF_REPO) — skipping repo-vs-box checks"
    REPO=""
else
    ok "checkout $REPO"
    if ! git -C "$REPO" diff --quiet 2>/dev/null; then
        warn "working tree is dirty — 'installed vs repo' below compares against your edits"
    fi
    behind=$(git -C "$REPO" rev-list --count HEAD..@{u} 2>/dev/null || echo 0)
    [ "${behind:-0}" -gt 0 ] && warn "$behind commit(s) behind origin — git pull"
fi

# ---------------------------------------------------------------------------
section "system basics"
# ---------------------------------------------------------------------------
# The locale bug this catches: an unanchored grep matched Arch's own
# commented default, so locale-gen generated nothing while locale.conf
# claimed en_US.UTF-8 — postgres then rejects the locale at initdb.
if locale -a 2>/dev/null | grep -qiE '^en_US\.utf-?8$'; then
    ok "locale en_US.UTF-8 generated"
else
    err "locale en_US.UTF-8 is NOT generated (locale.conf claims it)"
    note "fix: sudo sed -i 's/^#en_US.UTF-8 UTF-8\$/en_US.UTF-8 UTF-8/' /etc/locale.gen && sudo locale-gen"
fi

for unit in ff-stack docker tailscaled; do
    if systemctl is-enabled --quiet "$unit" 2>/dev/null; then
        if systemctl is-active --quiet "$unit" 2>/dev/null; then
            ok "$unit enabled + active"
        else
            err "$unit is enabled but NOT active"
        fi
    else
        warn "$unit is not enabled"
    fi
done

if [ -f /etc/sudoers.d/"ff-${USER}-nopasswd" ]; then
    if visudo -c -f /etc/sudoers.d/"ff-${USER}-nopasswd" >/dev/null 2>&1; then
        ok "sudoers drop-in valid"
    else
        err "sudoers drop-in FAILS validation — fix before it locks you out"
    fi
fi

# ---------------------------------------------------------------------------
section "tailnet"
# ---------------------------------------------------------------------------
# The identity lives on the host. A container claiming it means an old
# ff-tailscale is back, which silently shadows host sshd on port 22.
if command -v tailscale >/dev/null 2>&1; then
    if ts_ip=$(tailscale ip -4 2>/dev/null | head -1) && [ -n "$ts_ip" ]; then
        ok "host tailscaled up ($ts_ip)"
        if tailscale status --json 2>/dev/null | grep -q '"RunSSH": *true'; then
            warn "Tailscale SSH is ON — it intercepts port 22 ahead of sshd"
            note "fix: sudo tailscale set --ssh=false"
        fi
    else
        err "host tailscaled is not authenticated — run ff-bootstrap"
    fi
else
    err "tailscale is not installed on the host"
fi
if docker ps --format '{{.Names}}' 2>/dev/null | grep -qx ff-tailscale; then
    err "an ff-tailscale CONTAINER is running — it shadows the host's tailnet identity"
    note "the stack retired it on 2026-08-14; see migrations/2026-08-14-host-tailscale.sh"
fi

# ---------------------------------------------------------------------------
section "ingress stack"
# ---------------------------------------------------------------------------
if ! docker info >/dev/null 2>&1; then
    err "dockerd unreachable — skipping stack checks"
else
    for c in ff-caddy ff-cloudflared; do
        if docker ps --format '{{.Names}}' 2>/dev/null | grep -qx "$c"; then
            ok "$c running"
        elif [ "$c" = ff-cloudflared ]; then
            warn "$c not running (expected if COMPOSE_PROFILES lacks 'cloudflared')"
        else
            err "$c not running — public and private sites are both down"
        fi
    done

    # cloudflared must share caddy's netns; if it doesn't, the tunnel
    # can't reach localhost:8080 and every public site 502s.
    if docker ps --format '{{.Names}}' | grep -qx ff-cloudflared; then
        mode=$(docker inspect -f '{{.HostConfig.NetworkMode}}' ff-cloudflared 2>/dev/null)
        case "$mode" in
            container:*|service:caddy) ok "cloudflared shares caddy's netns" ;;
            *) err "cloudflared netns is '$mode' — expected to join caddy" ;;
        esac
    fi

    # Published ports are DNAT'd through FORWARD, which UFW never sees.
    # An empty DOCKER-USER means the only thing standing between the
    # open internet and caddy is the router.
    if sudo -n iptables -S DOCKER-USER 2>/dev/null | grep -q 'ff-managed'; then
        ok "DOCKER-USER ingress rules present"
    elif sudo -n true 2>/dev/null; then
        warn "DOCKER-USER has no ff-managed rules — published ports bypass UFW"
        note "fix: sudo systemctl restart ff-firewall"
    fi

    # The live Caddyfile is state, not a repo artifact — a parse failure
    # means the next reload will fail, so surface it before that.
    if [ -f /srv/stack/Caddyfile ]; then
        if docker exec ff-caddy caddy validate --config /etc/caddy/Caddyfile >/dev/null 2>&1; then
            ok "live Caddyfile validates"
        else
            err "live Caddyfile FAILS validation — the next reload will fail"
        fi
    fi
fi

# ---------------------------------------------------------------------------
section "board"
# ---------------------------------------------------------------------------
if ! command -v ff-board >/dev/null 2>&1; then
    warn "ff-board not installed — the kiosk falls back to btop"
else
    ok "ff-board installed"
    if [ -n "$REPO" ] && [ -d "$REPO/board/src" ]; then
        newest_src=$(find "$REPO/board/src" -name '*.rs' -newer /usr/local/bin/ff-board -print -quit 2>/dev/null)
        if [ -n "$newest_src" ]; then
            warn "board source is newer than the installed binary — rebuild"
            note "fix: cd $REPO/board && cargo build --release && sudo install -m 755 target/release/ff-board /usr/local/bin/ && pkill -x ff-board"
        else
            ok "installed binary is newer than board/src"
        fi
    fi

    # The check that would have caught the 2026-08-14 regression: the
    # board's assumptions about the stack, verified against the stack.
    if grep -q 'ff-tailscale' /usr/local/bin/ff-board 2>/dev/null; then
        err "installed ff-board still references ff-tailscale (retired container)"
        note "its tailnet stats and ALL site probes are dead — rebuild from current source"
    fi
fi

# ---------------------------------------------------------------------------
section "installed configs vs repo"
# ---------------------------------------------------------------------------
if [ -n "$REPO" ]; then
    check_file() {
        local src=$1 dst=$2
        [ -f "$src" ] || return 0
        if [ ! -e "$dst" ]; then
            warn "missing: $dst"
        elif ! cmp -s "$src" "$dst"; then
            warn "drifted: $dst differs from ${src#"$REPO"/}"
        else
            ok "${dst}"
        fi
    }
    check_file "$REPO/configs/zshrc"          "$HOME/.zshrc"
    check_file "$REPO/configs/zshenv"         "$HOME/.zshenv"
    check_file "$REPO/configs/zprofile"       "$HOME/.zprofile"
    check_file "$REPO/configs/zsh-prompt.zsh" "$HOME/.config/zsh/prompt.zsh"
    check_file "$REPO/configs/sway-config"    "$HOME/.config/sway/config"
    check_file "$REPO/configs/foot.ini"       "$HOME/.config/foot/foot.ini"
    check_file "$REPO/configs/ff-stack.service"    /etc/systemd/system/ff-stack.service
    check_file "$REPO/configs/ff-firewall.service" /etc/systemd/system/ff-firewall.service

    # Helpers: compare each repo helper against what's installed.
    drifted=0
    for h in "$REPO"/bin/ff-*; do
        n=$(basename "$h")
        if [ ! -x "/usr/local/bin/$n" ]; then
            warn "helper not installed: $n"
        elif ! cmp -s "$h" "/usr/local/bin/$n"; then
            drifted=$((drifted + 1))
        fi
    done
    if [ "$drifted" -gt 0 ]; then
        warn "$drifted helper(s) differ from the repo — re-run setup.sh to reinstall"
    else
        ok "helpers match the repo"
    fi
fi

# ---------------------------------------------------------------------------
section "migrations"
# ---------------------------------------------------------------------------
if [ -n "$REPO" ] && [ -d "$REPO/migrations" ]; then
    pending=0
    for m in "$REPO"/migrations/*.sh; do
        [ -e "$m" ] || continue
        n=$(basename "$m")
        [ "$n" = "_template.sh" ] && continue
        [ -f "/var/lib/farfield/migrations/$n" ] || { warn "pending migration: $n"; pending=$((pending + 1)); }
    done
    [ "$pending" -eq 0 ] && ok "all migrations applied"
    [ "$pending" -gt 0 ] && note "fix: ff-migrate"
fi

# ---------------------------------------------------------------------------
if [ "$QUIET" = 1 ] && [ "$ERRORS" = 0 ] && [ "$WARNS" = 0 ]; then
    exit 0
fi
echo
if [ "$ERRORS" -gt 0 ]; then
    printf "%bff-doctor: %d error(s), %d warning(s)%b\n" "$RED" "$ERRORS" "$WARNS" "$NC"
    exit 2
elif [ "$WARNS" -gt 0 ]; then
    printf "%bff-doctor: %d warning(s)%b\n" "$YELLOW" "$WARNS" "$NC"
    exit 1
else
    printf "%bff-doctor: all clear%b\n" "$GREEN" "$NC"
    exit 0
fi
