#!/bin/bash
# ff-tailnet-dns — let the box resolve the tailnet's own names.
#
# The box joins the tailnet with --accept-dns=false: a server keeps its own
# resolv.conf, and MagicDNS taking over every lookup is not something a
# server should inherit from a phone-shaped default. The cost was that the
# box could not resolve *.ts.net at all — its own name included — so anything
# running here (switchboard's agent, the farfield CLI, a health check) that
# followed a tailnet URL failed to look it up, while every other device on
# the tailnet reached the same URL fine. Routing was never the problem.
#
# This splits DNS instead of handing it over: on the tailscale0 link only,
# and only for the ts.net domain, ask Tailscale's resolver (100.100.100.100).
# Everything else keeps the box's own resolvers. Run by tailscaled's
# ExecStartPost, since the link (and its settings) is rebuilt on every start.
set -uo pipefail

LINK=tailscale0
for _ in $(seq 1 30); do
    ip link show "$LINK" >/dev/null 2>&1 && break
    sleep 1
done
if ! ip link show "$LINK" >/dev/null 2>&1; then
    echo "ff-tailnet-dns: no $LINK — tailnet names stay unresolvable" >&2
    exit 0
fi
resolvectl dns "$LINK" 100.100.100.100 &&
    resolvectl domain "$LINK" '~ts.net' &&
    resolvectl default-route "$LINK" false ||
    { echo "ff-tailnet-dns: resolvectl failed" >&2; exit 0; }
echo "ff-tailnet-dns: ts.net → 100.100.100.100 on $LINK"
