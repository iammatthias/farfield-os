#!/bin/bash
# ff-kiosk-shot [out.png] — screenshot the kiosk display.
#
# Works from any shell (including plain ssh): borrows the Wayland
# session env from a running foot tile and shoots with grim.
set -euo pipefail

case "${1:-}" in
    --help | -h)
        echo "usage: ff-kiosk-shot [out.png]   (default /tmp/ff-kiosk.png)"
        exit 0
        ;;
esac

out=${1:-/tmp/ff-kiosk.png}
pid=$(pgrep -x foot | head -1) || { echo "ff-kiosk-shot: no kiosk session" >&2; exit 1; }

env_of() { tr '\0' '\n' < "/proc/$pid/environ" | grep "^$1=" | cut -d= -f2-; }
WAYLAND_DISPLAY=$(env_of WAYLAND_DISPLAY) \
XDG_RUNTIME_DIR=$(env_of XDG_RUNTIME_DIR) \
    grim "$out"
echo "$out"
