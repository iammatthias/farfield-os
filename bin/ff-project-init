#!/bin/bash
# farfield os — bootstrap a project directory for agent-assisted work.
#
# Creates the directory, drops a starter CLAUDE.md (the system context
# Claude Code reads when working in the project), and git-inits it.
#
# Usage: ff-project-init <path> [description]
#   ff-project-init /srv/projects/foo "backend API, FastAPI + Postgres"

# set -e matters here: if mkdir fails, the `cd` below must not silently
# no-op and git-init the caller's CWD.
set -euo pipefail

PROJECT_PATH=${1:-}
DESCRIPTION=${2:-}

if [ -z "$PROJECT_PATH" ] || [ "$PROJECT_PATH" = "--help" ] || [ "$PROJECT_PATH" = "-h" ]; then
    cat <<'USAGE'
Usage: ff-project-init <path> [description]

Example:
  ff-project-init /srv/projects/foo "backend API, FastAPI + Postgres"
USAGE
    exit 1
fi

mkdir -p "$PROJECT_PATH"
PROJECT_PATH=$(cd "$PROJECT_PATH" && pwd)
cd "$PROJECT_PATH" || { echo "cannot cd into $PROJECT_PATH"; exit 1; }

NAME=$(basename "$PROJECT_PATH")

# 1. git
if [ -d .git ]; then
    echo "  [skip] already a git repo"
else
    git init -q
    echo "  [+] git initialized"
fi

# 2. CLAUDE.md
if [ -f CLAUDE.md ]; then
    echo "  [skip] CLAUDE.md already exists"
else
    cat > CLAUDE.md <<EOF
# $NAME

${DESCRIPTION:-_(Add a one-line description here.)_}

## Conventions

- Language / framework:
- Build system:
- Test command:
- Run-dev command:

## Layout

\`\`\`
(directory map — fill in once the project has structure)
\`\`\`

## Notes for Claude

- Anything Claude should *always* do (lint before commit, run tests after
  edits, etc.) goes here.
- Anything Claude should *never* do (touch certain dirs, run network calls,
  etc.) goes here.
EOF
    echo "  [+] CLAUDE.md template written"
fi

echo
echo "Project ready: $PROJECT_PATH"
echo "ssh in and run \`claude\` there to start working on it."
