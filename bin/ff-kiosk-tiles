#!/bin/bash
# farfield os — spawn the six kiosk dashboard tiles and arrange them 3x2 under sway.
#
# Launched by sway's `exec` (see configs/sway-config). sway has no auto-grid,
# so the grid is built explicitly: three columns across the top (host claude
# net), then each column is split into two rows (disk containers status).
#
#   HOST(CPU+MEM)  CLAUDE      NET
#   DISK           CONTAINERS  STATUS(OPS)
#
# Each tile runs `ff-board <panel>` (single-panel mode) in a respawn loop so
# a crash never leaves a hole in the mosaic. A tap fullscreens a tile; the
# fullscreen OPS view carries the action buttons.

set -u

# Small displays (set by ~/.zprofile) override the foot font; unset → foot.ini.
font_args=()
[ -n "${FF_KIOSK_FONT:-}" ] && font_args=(--font="$FF_KIOSK_FONT")

# ff-board is built from source by setup.sh; a box provisioned without a
# working cargo toolchain won't have it. Without this check every tile
# would respawn a missing binary twice a second, forever, showing six
# empty terminals — the panel's failure mode should be legible instead.
# btop in the first tile gives a usable display and the rest say why.
if command -v ff-board >/dev/null 2>&1; then
    BOARD_OK=1
else
    BOARD_OK=0
    logger -t ff-kiosk-tiles "ff-board not installed — falling back to btop (build it: cargo build --release in board/)"
fi

launch() {
    local panel=$1 cmd
    if [ "$BOARD_OK" = 1 ]; then
        cmd="while :; do ff-board $panel; sleep 2; done"
    elif [ "$panel" = host ] && command -v btop >/dev/null 2>&1; then
        cmd="while :; do btop; sleep 2; done"
    else
        # Static, quiet, and honest — no respawn storm behind it.
        cmd="printf '\n  ff-board is not installed.\n\n  Build it:\n    cd ~/farfield-os/board && cargo build --release\n    sudo install -m 755 target/release/ff-board /usr/local/bin/\n    ff-kiosk-restart\n\n'; sleep infinity"
    fi
    foot --app-id="ff-$panel" "${font_args[@]}" -e sh -c "$cmd" &
}

# Block until a panel's window is present in sway's tree, so the next
# swaymsg acts on the intended layout state (spawns are async). Returns 1
# on timeout — the caller logs it and continues best-effort (a possibly
# scrambled mosaic beats no tiles at all).
wait_win() {
    local p
    for _ in $(seq 1 30); do
        p=$(swaymsg -t get_tree 2>/dev/null | grep -c "\"ff-$1\"")
        [ "${p:-0}" -ge 1 ] && return 0
        sleep 0.2
    done
    return 1
}
tile_warn() { logger -t ff-kiosk-tiles "ff-$1 window never appeared — continuing; layout may be scrambled"; }
focus() { swaymsg "[app_id=\"ff-$1\"] focus" >/dev/null 2>&1; }

# Top row: three columns.
launch host;   wait_win host   || tile_warn host
launch claude; wait_win claude || tile_warn claude
launch net;    wait_win net    || tile_warn net

# Split each column into two rows (bottom-row panel under each top one).
focus host;   swaymsg splitv >/dev/null 2>&1; launch disk;       wait_win disk       || tile_warn disk
focus claude; swaymsg splitv >/dev/null 2>&1; launch containers; wait_win containers || tile_warn containers
focus net;    swaymsg splitv >/dev/null 2>&1; launch status;     wait_win status     || tile_warn status

wait
