#!/bin/bash
# farfield os — docker containers + pm2 processes, formatted for the dashboard pane.
#
# A dedicated helper (mirroring ff-services-status)
# rather than an inline command string — the latter was fragile to quote
# inside tmux and silently killed its pane.
set -uo pipefail

printf '\033[1;36m═══ Docker ═══\033[0m\n'
# Names + status only — the full {{.Ports}} string (dual IPv4/IPv6 maps)
# wraps and clutters a narrow pane. Per-site URLs already live in the
# services+caddy pane.
if systemctl is-active --quiet docker; then
    docker ps --format 'table {{.Names}}\t{{.Status}}' 2>/dev/null \
        | sed 's/^/  /' \
        || echo '  (unable to list containers)'
else
    echo '  (docker inactive)'
fi

echo
printf '\033[1;36m═══ pm2 ═══\033[0m\n'
if command -v pm2 >/dev/null 2>&1; then
    # Probe without side effects — `pm2 pid` auto-SPAWNS the daemon, which
    # a read-only status pane must never do. Check the daemon pidfile
    # liveness (or its process) instead.
    pm2_pid=$(cat "$HOME/.pm2/pm2.pid" 2>/dev/null)
    if { [ -n "${pm2_pid:-}" ] && kill -0 "$pm2_pid" 2>/dev/null; } \
        || pgrep -f 'PM2 .*God Daemon' >/dev/null 2>&1; then
        pm2 list --no-color 2>/dev/null | sed 's/^/  /'
    else
        echo '  (pm2 daemon not running — no managed processes)'
    fi
else
    echo '  (pm2 not installed)'
fi
