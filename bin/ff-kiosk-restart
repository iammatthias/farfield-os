#!/bin/bash
# ff-kiosk-restart — gracefully restart the sway kiosk.
#
# `swaymsg exit` quits sway cleanly; getty@tty1's autologin then respawns it
# via ~/.zprofile with fresh config. Works from any shell (incl. plain ssh):
# it borrows the Wayland session env from a running foot tile so swaymsg can
# reach the compositor.
set -uo pipefail

# Record the dying compositor's PID up front — the verify loop below must
# match a NEW sway, not the old one still winding down after `swaymsg exit`.
old_sway=$(pgrep -x sway | head -1 || true)

pid=$(pgrep -x foot | head -1 || true)
if [ -n "${pid:-}" ]; then
    env_of() { tr '\0' '\n' < "/proc/$1/environ" | grep "^$2=" | cut -d= -f2-; }
    WAYLAND_DISPLAY=$(env_of "$pid" WAYLAND_DISPLAY) \
    XDG_RUNTIME_DIR=$(env_of "$pid" XDG_RUNTIME_DIR) \
    SWAYSOCK=$(env_of "$pid" SWAYSOCK) \
        swaymsg exit 2>/dev/null || pkill -x sway || true
else
    pkill -x sway || true
fi

# Wait for the old sway to actually die first.
if [ -n "${old_sway:-}" ]; then
    for _ in $(seq 1 15); do
        kill -0 "$old_sway" 2>/dev/null || break
        sleep 1
    done
    if kill -0 "$old_sway" 2>/dev/null; then
        echo "ff-kiosk-restart: old sway (pid $old_sway) still running — restart did not take" >&2
        exit 1
    fi
fi

# Now wait for a NEW sway session with a full set of tiles.
for _ in $(seq 1 30); do
    new_sway=$(pgrep -x sway | head -1 || true)
    if [ -n "${new_sway:-}" ] && [ "$new_sway" != "${old_sway:-}" ] \
        && [ "$(pgrep -xc foot)" -ge 6 ]; then
        echo "kiosk restarted"
        exit 0
    fi
    sleep 2
done
echo "ff-kiosk-restart: kiosk did not come back — check getty@tty1 / ~/.zprofile" >&2
exit 1
