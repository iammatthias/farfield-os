#!/bin/bash
# farfield os — interactive post-install: tailscale auth, Claude Code login,
# optional gh + cloudflared. Idempotent.
#
# Run once after `sudo reboot` from setup.sh. Re-runnable any time —
# steps already complete are skipped automatically.
#
# Day-to-day management of the box is Claude Code over SSH (ssh in, run
# `claude`) — this wizard just gets the auth in place.

set -uo pipefail

STACK=/srv/stack
COMPOSE=(docker compose -f "$STACK/docker-compose.yml")

GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
DIM='\033[2m'
NC='\033[0m'

step()  { printf "\n%b━━━ %s ━━━%b\n" "$GREEN" "$1" "$NC"; }
ok()    { printf "%b✓%b %s\n" "$GREEN" "$NC" "$1"; }
skip()  { printf "%b↩ %s%b\n" "$DIM" "$1" "$NC"; }
warn()  { printf "%b!%b %s\n" "$YELLOW" "$NC" "$1"; }
fail()  { printf "%b✗%b %s\n" "$RED" "$NC" "$1"; }
info()  { printf "  %s\n" "$1"; }

ask() {
    local prompt=$1
    local default=${2:-Y}
    local yn
    if [ "$default" = "Y" ]; then
        read -r -p "$prompt [Y/n] " yn
        case "$yn" in [Nn]*) return 1 ;; *) return 0 ;; esac
    else
        read -r -p "$prompt [y/N] " yn
        case "$yn" in [Yy]*) return 0 ;; *) return 1 ;; esac
    fi
}

# ---------------------------------------------------------------------------
# Preflight
# ---------------------------------------------------------------------------
step "Preflight"

if [ ! -d "$STACK" ]; then
    fail "$STACK not found — run setup.sh first."
    exit 1
fi

if ! systemctl is-active --quiet ff-stack; then
    warn "ff-stack.service inactive. Starting it now..."
    sudo systemctl start ff-stack
fi

# Wait for compose services to be up (poll for ~2 min before giving up).
for i in $(seq 1 24); do
    if "${COMPOSE[@]}" ps --status running 2>/dev/null | grep -q ff-caddy; then
        ok "Stack is up"
        break
    fi
    [ "$i" = 24 ] && { fail "Stack not running after 2 minutes. Check: sudo journalctl -fu ff-stack"; exit 1; }
    [ "$i" = 1 ]  && printf "%bWaiting for containers" "$DIM"
    printf "."
    sleep 5
done
echo

# ---------------------------------------------------------------------------
# Tailscale (host tailscaled — the box's one tailnet identity; there is
# no tailscale container. sshd and caddy's published ports are both
# reachable on this node's IP.)
# ---------------------------------------------------------------------------
step "Tailscale"

TS_IP=$(tailscale ip -4 2>/dev/null | head -1)
if [ -n "$TS_IP" ]; then
    ok "Already on the tailnet ($TS_IP)"
else
    warn "The host isn't on the tailnet yet."
    info "A login URL will print below — open it and approve the device."
    info "This is what makes \`ssh $(hostname)\` work from anywhere."
    echo
    # --accept-dns=false: a server should keep its own resolv.conf.
    # No --ssh: plain sshd answers on the tailnet IP; Tailscale SSH
    # would intercept it and change the auth model.
    sudo tailscale up --accept-dns=false
    TS_IP=$(tailscale ip -4 2>/dev/null | head -1)
    if [ -n "$TS_IP" ]; then
        ok "Authenticated. Tailnet IP: $TS_IP"
    else
        warn "Tailscale auth didn't complete. Re-run ff-bootstrap."
    fi
fi

# ---------------------------------------------------------------------------
# Claude Code (host)
# ---------------------------------------------------------------------------
step "Claude Code"

if [ -f "$HOME/.claude/.credentials.json" ] || [ -f "$HOME/.claude/auth.json" ]; then
    ok "Already authenticated"
elif ! command -v claude &>/dev/null; then
    warn "claude not on PATH — log out/in to pick up ~/.npm-global/bin, then re-run."
else
    warn "Claude Code isn't logged in."
    info "Inside the claude prompt: type /login, finish the browser flow, then /exit."
    if ask "Run claude now?"; then
        claude
    else
        skip "Claude — re-run ff-bootstrap later."
    fi
fi

# ---------------------------------------------------------------------------
# Optional: GitHub CLI (host)
# ---------------------------------------------------------------------------
step "GitHub CLI (optional)"

if ! command -v gh &>/dev/null; then
    skip "gh not installed (pacman -S github-cli) — git push over SSH works without it."
elif gh auth status 2>&1 | grep -q 'Logged in to github.com'; then
    ok "gh already authenticated"
elif ask "Authenticate gh now (PRs / issues from the box)?" N; then
    gh auth login --hostname github.com --git-protocol https --web
else
    skip "gh — git push still works without it; run later if you want the API."
fi

# ---------------------------------------------------------------------------
# Optional: Cloudflare Tunnel
# ---------------------------------------------------------------------------
step "Cloudflare Tunnel (optional)"

CF_TOKEN=$(sudo awk -F= '/^CLOUDFLARED_TOKEN=/{print $2}' "$STACK/.env" 2>/dev/null | tr -d '"' | tr -d "'")
if [ -n "${CF_TOKEN:-}" ]; then
    # cloudflared is profile-gated in the compose file — the connector only
    # exists when COMPOSE_PROFILES includes "cloudflared". Ensure that's in
    # .env (compose reads it from the project dir) before any `up -d`.
    if sudo grep -q '^COMPOSE_PROFILES=' "$STACK/.env" 2>/dev/null; then
        if ! sudo grep -q '^COMPOSE_PROFILES=.*cloudflared' "$STACK/.env" 2>/dev/null; then
            sudo sed -i 's/^COMPOSE_PROFILES=.*/&,cloudflared/' "$STACK/.env"
            ok "Added cloudflared to COMPOSE_PROFILES in $STACK/.env"
        fi
    else
        echo 'COMPOSE_PROFILES=cloudflared' | sudo tee -a "$STACK/.env" >/dev/null
        ok "Set COMPOSE_PROFILES=cloudflared in $STACK/.env"
    fi
    if "${COMPOSE[@]}" ps --status running cloudflared 2>/dev/null | grep -q cloudflared; then
        ok "Tunnel connector already running"
    else
        warn "CLOUDFLARED_TOKEN is set; starting the connector."
        sudo "${COMPOSE[@]}" up -d cloudflared
        ok "cloudflared up. Add public sites with: add-public-site <host> <port>"
    fi
else
    skip "Set CLOUDFLARED_TOKEN in /srv/stack/.env and re-run ff-bootstrap to enable."
fi

# ---------------------------------------------------------------------------
# Summary
# ---------------------------------------------------------------------------
step "Where things are"

TS_IP=${TS_IP:-$(tailscale ip -4 2>/dev/null | head -1)}
[ -n "$TS_IP" ] || TS_IP='<run ff-bootstrap again>'

cat <<EOF
  Manage the box  ssh in, run \`claude\` (Claude Code, subscription auth)
  Dashboard       ff-dashboard (run it inside herdr to persist) — or the kiosk
  Stack logs      sudo journalctl -fu ff-stack
                  cd $STACK && docker compose logs -f caddy
  Add a site      add-site <name> <port>           # private, tailnet
                  add-public-site <host> <port>    # public, via cloudflared
  Tailnet IP      $TS_IP ($(hostname)) — ssh and served sites both land here

If something's off, re-run \`ff-bootstrap\` — it skips steps that are
already done and re-prompts the ones that aren't.
EOF
