#!/bin/bash
# ff-deploy <project> — pull the latest commit for a project under
# $FF_PROJECTS/<project> (default ~/projects) and rebuild its Docker
# stack. Named volumes survive the rebuild, so data is preserved.
#
#   ff-deploy myapp
#
# FF_PROJECTS overrides the project root (default ~/projects).
#
# A project that also builds a host service rides along: deploying the
# checkout ff-switchboard builds from (~/projects/farfield) redeploys the
# switchboard unit after the stack, so the one app that is not a container
# never runs an old binary against new siblings.
set -euo pipefail

name="${1:-}"
if [ -z "$name" ]; then
    echo "usage: ff-deploy <project>"
    echo "  git-pulls \$FF_PROJECTS/<project> (default ~/projects) and rebuilds its docker compose stack"
    exit 1
fi

dir="${FF_PROJECTS:-$HOME/projects}/$name"
if [ ! -d "$dir/.git" ]; then
    echo "ff-deploy: $dir is not a git checkout" >&2
    exit 1
fi

# The compose file lives at the repo root or in a deploy/ subdir, under
# any of compose's accepted spellings.
compose_dir=""
for d in "$dir/deploy" "$dir"; do
    for f in docker-compose.yml docker-compose.yaml compose.yml compose.yaml; do
        if [ -f "$d/$f" ]; then
            compose_dir="$d"
            break 2
        fi
    done
done
if [ -z "$compose_dir" ]; then
    echo "ff-deploy: no compose file (docker-compose.y[a]ml / compose.y[a]ml) found under $name" >&2
    exit 1
fi

echo "==> $name: git pull"
git -C "$dir" pull --ff-only

echo "==> $name: docker compose up -d --build"
cd "$compose_dir"
docker compose up -d --build
docker compose ps --format 'table {{.Name}}\t{{.Status}}'

# switchboard: a systemd unit, not a container. Only where it is installed —
# a box without the unit has nothing to redeploy.
sb_project="${FF_SWITCHBOARD_PROJECT:-$HOME/projects/farfield}"
if [ "$(realpath "$dir")" = "$(realpath "$sb_project" 2>/dev/null || echo -)" ] &&
    command -v ff-switchboard >/dev/null 2>&1 &&
    systemctl cat ff-switchboard.service >/dev/null 2>&1; then
    echo "==> $name: switchboard (host unit)"
    ff-switchboard deploy
fi
